MODEL_PATH=/data/temp/yhb/DeepSeek-V4-Flash
MODEL_QUANTIZATION=awq
MODEL_DTYPE=float16
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.80

VLLM_IMAGE=lmcache/vllm-openai:latest
LMCACHE_IMAGE=lmcache/standalone:nightly
VLLM_API_KEY=sk-123
GATEWAY_API_KEY=sk-123

PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_DEFAULT_TIMEOUT=120
PIP_RETRIES=10

PREFILL_TIMEOUT_SECONDS=300
DECODE_TIMEOUT_SECONDS=300
PREFILL_MAX_TOKENS=1

PREFILL_MAX_NUM_SEQS=16
PREFILL_MAX_NUM_BATCHED_TOKENS=32768
DECODE_MAX_NUM_SEQS=32
DECODE_MAX_NUM_BATCHED_TOKENS=8192
DECODE_SCHEDULER_DELAY_FACTOR=0.0

NCCL_P2P_DISABLE=1
NCCL_IB_DISABLE=1
NCCL_SHM_DISABLE=0
NCCL_DEBUG=WARN
NCCL_CUMEM_ENABLE=0
NCCL_CUMEM_HOST_ENABLE=0
VLLM_WORKER_MULTIPROC_METHOD=spawn
OMP_NUM_THREADS=1
LMCACHE_MP_PORT=6555
LMCACHE_HTTP_PORT=8080
LMCACHE_L1_SIZE_GB=60
LMCACHE_MAX_WORKERS=4
LMCACHE_EVICTION_POLICY=LRU
LMCACHE_LOG_LEVEL=INFO
