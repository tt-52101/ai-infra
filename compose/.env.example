MODEL_PATH=/data/temp/yhb/DeepSeek-V4-Flash
MODEL_QUANTIZATION=awq
MODEL_DTYPE=float16
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.80

VLLM_IMAGE=lmcache/vllm-openai:latest
LMCACHE_IMAGE=lmcache/lmcache-server:latest
VLLM_API_KEY=sk-123
GATEWAY_API_KEY=sk-123

PREFILL_TIMEOUT_SECONDS=300
DECODE_TIMEOUT_SECONDS=300
PREFILL_MAX_TOKENS=1

PREFILL_MAX_NUM_SEQS=16
PREFILL_MAX_NUM_BATCHED_TOKENS=32768
DECODE_MAX_NUM_SEQS=32
DECODE_MAX_NUM_BATCHED_TOKENS=8192
DECODE_SCHEDULER_DELAY_FACTOR=0.0

NCCL_P2P_DISABLE=1
NCCL_IB_DISABLE=1
NCCL_SHM_DISABLE=0
LMCACHE_STORAGE_PATH=./lmcache_storage
